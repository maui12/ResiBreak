# Copia este archivo a .env (no se sube a git). La API no arranca si falta algo obligatorio.
DB_HOST=localhost
DB_PORT=5432
DB_USER=becados
DB_PASSWORD=becados
DB_NAME=becados
# Solo desarrollo: crea/actualiza tablas solas. En producción usar migraciones y false.
DB_SYNC=true

JWT_SECRET=cambia-esto-por-un-texto-largo-de-al-menos-32-caracteres
# Primer administrador (se crea solo si no hay usuarios). RUT válido y clave de al menos 12 caracteres.
ADMIN_RUT=11111111-1
ADMIN_PASSWORD=cambia-esta-clave-larga

PORT=3000
# Solo para el web; la app móvil no usa CORS
CORS_ORIGINS=
# Necesario: la regla de anticipación de turnos usa la hora local del servidor
TZ=America/Santiago
