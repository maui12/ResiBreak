# Copia este archivo a .env (no se sube a git). La API no arranca si falta algo obligatorio.
DB_HOST=localhost
DB_PORT=5433
DB_USER=becados
DB_PASSWORD=becados
DB_NAME=becados
# Solo desarrollo: crea/actualiza tablas solas. En producción usar migraciones y false.
DB_SYNC=true

JWT_SECRET=lavacalolalavacalolatienecabezaytienecola
# Primer administrador (se crea solo si no hay usuarios)
ADMIN_EMAIL=admin@ejemplo.cl
ADMIN_PASSWORD=adminsupremoxd

PORT=3000
# Orígenes del navegador permitidos: web (Vite, 5173) y app móvil abierta en el navegador (Expo web, 8081).
# La app nativa en el celular no usa CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Necesario: la regla de anticipación de turnos usa la hora local del servidor
TZ=America/Santiago

# Solo desarrollo: crea un residente de prueba (RUT 11111111-1) al arrancar. Se ignora con NODE_ENV=production.
SEED_DEMO=true

# --- Correo (ver src/correo/README.md) ---
# consola = no envía, solo lo registra en el log (por defecto) · smtp = envía de verdad · memoria = tests
CORREO_PROVEEDOR=consola
# Con CORREO_PROVEEDOR=smtp. Ejemplo con Mailpit local (docker compose --profile correo up -d mailpit):
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# CORREO_REMITENTE="ResiBreak <no-responder@resibreak.cl>"
# URL pública de la app, para los enlaces de los correos
# CORREO_URL_APP=http://localhost:8081
