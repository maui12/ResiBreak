# Dirección del backend. En un celular físico NO sirve "localhost":
# usa la IP de tu computador en la red WiFi.
#   - Celular físico:     http://192.168.1.50:3000/api
#   - Emulador Android:   http://10.0.2.2:3000/api
#   - Simulador iOS:      http://localhost:3000/api
EXPO_PUBLIC_API_URL=http://192.168.1.50:3000/api

# Solo desarrollo, mientras el login no esté conectado al backend.
# Pega aquí el accessToken que devuelve POST /api/auth/login.
# (Las variables EXPO_PUBLIC_* quedan dentro del bundle: no uses un token real en producción.)
EXPO_PUBLIC_API_TOKEN=

# Id de un residente que exista en tu base de datos (tabla becados).
EXPO_PUBLIC_RESIDENTE_ID=1
# Login de demostración (temporal). Deben coincidir con ADMIN_EMAIL / ADMIN_PASSWORD del .env de la API.
# Con esto ya no hace falta EXPO_PUBLIC_API_TOKEN ni EXPO_PUBLIC_RESIDENTE_ID.
# ⚠ Quedan dentro de la app compilada: solo desarrollo.
EXPO_PUBLIC_DEMO_EMAIL=admin@ejemplo.cl
EXPO_PUBLIC_DEMO_PASSWORD=cambia-esta-clave
