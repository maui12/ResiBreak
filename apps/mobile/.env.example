# Dirección del backend. En un celular físico NO sirve "localhost":
# usa la IP de tu computador en la red WiFi.
#   - Celular físico:     http://192.168.1.50:3000/api
#   - Emulador Android:   http://10.0.2.2:3000/api
#   - Simulador iOS:      http://localhost:3000/api
EXPO_PUBLIC_API_URL=http://192.168.1.50:3000/api

# El inicio de sesión es con RUT y contraseña de una cuenta creada en la API
# (POST /api/usuarios, como administrador). Ya no se usan EXPO_PUBLIC_API_TOKEN,
# EXPO_PUBLIC_RESIDENTE_ID ni EXPO_PUBLIC_DEMO_*.
